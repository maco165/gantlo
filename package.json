{
  "name": "gantlo",
  "version": "0.1.0",
  "private": true,
  "description": "gantlo: API と HTTP の基礎を、問題を解きながら学ぶ学習サイト。ガントチャートで計画し、進捗はブラウザに残す。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "check:content": "node scripts/check-content.mjs",
    "readme:images": "vite build && node scripts/prerender.mjs && node scripts/readme-images.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-gothic": "0.7.16",
    "@heroicons/react": "2.2.0",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "postcss": "8.5.33",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
